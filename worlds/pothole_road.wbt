Robot {
  translation 0.0 -0.50 0.12
  rotation 0 0 1 0
  name "pothole_robot"
  controller "pothole_controller"
  synchronization TRUE
  children [
    # Robot Chassis
    Transform {
      translation 0 0 0
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.35 0.65
            roughness 0.4
            metalness 0.5
          }
          geometry Box { size 0.30 0.20 0.06 }
        }
      ]
    }
    # Navigation Sensors
    GPS {
      name "gps"
      translation 0 0 0.03
    }
    InertialUnit {
      name "imu"
      translation 0 0 0.03
    }
    # Perception Camera
    Camera {
      name "camera"
      translation 0.15 0.0 0.06
      rotation 0 1 0 0.45
      fieldOfView 1.0
      width 160
      height 120
    }
    # Warning LEDs
    LED {
      name "led_red"
      translation 0.14 0.08 0.04
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.8 0.1 0.1 roughness 0.2 }
          geometry Sphere { radius 0.015 }
        }
      ]
      color [ 1 0 0 ]
    }
    LED {
      name "led_green"
      translation 0.14 -0.08 0.04
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.1 0.8 0.1 roughness 0.2 }
          geometry Sphere { radius 0.015 }
        }
      ]
      color [ 0 1 0 ]
    }
    # Warning Speaker / Buzzer
    Speaker {
      name "speaker"
      translation 0.0 0.0 0.04
    }
    # Rear LCD Display Mast
    Transform {
      translation -0.12 0.0 0.08
      children [
        # Mast post
        Shape {
          appearance PBRAppearance { baseColor 0.2 0.2 0.2 roughness 0.5 }
          geometry Box { size 0.02 0.02 0.10 }
        }
        # LCD Screen casing facing rear (-x)
        Transform {
          translation -0.01 0.0 0.05
          children [
            Shape {
              appearance PBRAppearance { baseColor 0.05 0.05 0.05 roughness 0.3 }
              geometry Box { size 0.01 0.14 0.08 }
            }
          ]
        }
      ]
    }
    Display {
      name "lcd"
      width 256
      height 128
    }
    # Wheel Joint: wheel_fl
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.1 0.11 0.0
      }
      device [
        RotationalMotor {
          name "wheel_fl"
        }
        PositionSensor {
          name "wheel_fl_sensor"
        }
      ]
      endPoint Solid {
        translation 0.1 0.11 0.0
        rotation 0 1 0 0
        children [
          Transform {
            rotation 1 0 0 1.57079632679
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.1 0.1 0.1
                  roughness 0.9
                }
                geometry Cylinder {
                  height 0.03
                  radius 0.06
                }
              }
            ]
          }
        ]
        boundingObject Transform {
          rotation 1 0 0 1.57079632679
          children [
            Cylinder { height 0.03 radius 0.06 }
          ]
        }
        physics Physics {
          density -1
          mass 0.4
        }
      }
    }
    # Wheel Joint: wheel_fr
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.1 -0.11 0.0
      }
      device [
        RotationalMotor {
          name "wheel_fr"
        }
        PositionSensor {
          name "wheel_fr_sensor"
        }
      ]
      endPoint Solid {
        translation 0.1 -0.11 0.0
        rotation 0 1 0 0
        children [
          Transform {
            rotation 1 0 0 1.57079632679
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.1 0.1 0.1
                  roughness 0.9
                }
                geometry Cylinder {
                  height 0.03
                  radius 0.06
                }
              }
            ]
          }
        ]
        boundingObject Transform {
          rotation 1 0 0 1.57079632679
          children [
            Cylinder { height 0.03 radius 0.06 }
          ]
        }
        physics Physics {
          density -1
          mass 0.4
        }
      }
    }
    # Wheel Joint: wheel_rl
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.1 0.11 0.0
      }
      device [
        RotationalMotor {
          name "wheel_rl"
        }
        PositionSensor {
          name "wheel_rl_sensor"
        }
      ]
      endPoint Solid {
        translation -0.1 0.11 0.0
        rotation 0 1 0 0
        children [
          Transform {
            rotation 1 0 0 1.57079632679
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.1 0.1 0.1
                  roughness 0.9
                }
                geometry Cylinder {
                  height 0.03
                  radius 0.06
                }
              }
            ]
          }
        ]
        boundingObject Transform {
          rotation 1 0 0 1.57079632679
          children [
            Cylinder { height 0.03 radius 0.06 }
          ]
        }
        physics Physics {
          density -1
          mass 0.4
        }
      }
    }
    # Wheel Joint: wheel_rr
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.1 -0.11 0.0
      }
      device [
        RotationalMotor {
          name "wheel_rr"
        }
        PositionSensor {
          name "wheel_rr_sensor"
        }
      ]
      endPoint Solid {
        translation -0.1 -0.11 0.0
        rotation 0 1 0 0
        children [
          Transform {
            rotation 1 0 0 1.57079632679
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.1 0.1 0.1
                  roughness 0.9
                }
                geometry Cylinder {
                  height 0.03
                  radius 0.06
                }
              }
            ]
          }
        ]
        boundingObject Transform {
          rotation 1 0 0 1.57079632679
          children [
            Cylinder { height 0.03 radius 0.06 }
          ]
        }
        physics Physics {
          density -1
          mass 0.4
        }
      }
    }
  ]
  boundingObject Transform {
    translation 0 0 0
    children [ Box { size 0.30 0.20 0.06 } ]
  }
  physics Physics {
    density -1
    mass 3.5
    centerOfMass [ 0 0 -0.01 ]
  }
}
